class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        int i,j;
        i=0;
        j=digits.size();
        if(digits[j-1]!=9)
        {
         digits[j-1]+=1;
         return digits;
        }
        else
        {
            digits.insert(digits.begin(),1);
            digits[j]=0;
            return digits;
        }

    }
};